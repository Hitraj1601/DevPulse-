# ==============================================================================
# DevPulse AI — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Copy this file to .env for local overrides
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devpulse_db
POSTGRES_USER=devpulse_app
POSTGRES_PASSWORD=devpulse_local_dev_secret_change_in_prod

# Ingestion Buffer (Redis 7.4)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=telemetry.events.v1
REDIS_CONSUMER_GROUP=devpulse-incident-engine

# Main Java Backend API
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DEVPULSE_DEV_INGESTION_ENABLED=true
DEVPULSE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Go Ingestion Gateway (Phase 2)
GO_PORT=8081

# Security & Tokens (Phase 3)
JWT_SECRET=change_me_to_a_secure_base64_encoded_256bit_random_key_placeholder
JWT_EXPIRATION_SECONDS=86400

# External AI Provider (Phase 10 - Advisory Only)
# Supported options: mock | openai | gemini
SPRING_AI_PROVIDER=mock
AI_API_KEY=placeholder-api-key-never-commit-real-keys
AI_MODEL_NAME=gemini-1.5-pro

# GitHub Deployments Webhook (Phase 11)
GITHUB_WEBHOOK_SECRET=placeholder-webhook-hmac-secret
